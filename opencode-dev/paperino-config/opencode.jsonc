{
  "$schema": "https://opencode.ai/config.json",
  // Default writing model — change freely in the model picker.
  // GPT-5.6 Terra, billed against the ChatGPT subscription rather than per token:
  // `opencode auth login` -> OpenAI -> ChatGPT drives the OAuth in the built-in codex
  // plugin (plugin/openai/codex.ts), which routes requests at
  // chatgpt.com/backend-api/codex/responses. Usage is quota-shaped (5-hour / weekly
  // windows), not token-shaped.
  "model": "openai/gpt-5.6-terra",
  // models.dev's catalog stops at gpt-5.2, so Terra has to be declared by hand or it
  // never reaches the model picker. The codex plugin's OAuth gate admits it on its own —
  // it keeps any `gpt-<major>.<minor>` above 5.4 (codex.ts:288) — and the reasoning-effort
  // tiers are derived from the version in the id, so 5.6 gets the full set with no extra
  // config.
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "id": "gpt-5.6-terra",
          "name": "GPT-5.6 Terra",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          // Inherited from the numbers the codex plugin pins for gpt-5.5 (codex.ts:300).
          // If OpenAI publishes different limits for Terra, correct them here.
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 128000
          }
        }
      }
    }
  },
  // Paperino does not use InteJer's hardware/IoT MCP servers, which come from the
  // shared global config (~/.config/opencode/opencode.jsonc). Disable them here so
  // the paper-writing agent has a clean tool surface — without touching the global file.
  "mcp": {
    // Code-authored publication figures: scaffold/render/lint/review + data_query.
    // Runs on bun; the renderer shells out to node internally (playwright hangs under bun).
    "figures": {
      "type": "local",
      "command": ["bun", "C:/Users/azamk/Documents/Paperino/figures-mcp/src/server.ts"],
      "enabled": true
    },
    // PaperBanana image generation. Its own venv; models pinned inside the server.
    // Generation takes a minute or more, so the default MCP timeout is not enough.
    "paperbanana": {
      "type": "local",
      "command": [
        "C:/Users/azamk/Documents/Paperino/paperbanana-mcp/.venv/Scripts/python.exe",
        "C:/Users/azamk/Documents/Paperino/paperbanana-mcp/server.py"
      ],
      "enabled": true,
      "timeout": 600000
    },
    "freecad": { "enabled": false },
    "kicad": { "enabled": false },
    "partfetch": { "enabled": false },
    "platformio": { "enabled": false },
    "playwright": { "enabled": false },
    "mongodb": { "enabled": false },
    "thingsboard": { "enabled": false },
    "embedded-debugger": { "enabled": false },
    "stitch": { "enabled": false }
  },
  // Skills are discovered from the global config dir too (skill/index.ts reads
  // config.directories(), which always includes ~/.config/opencode). Deny InteJer's
  // hardware/IoT skills so the paper-writing agent has a clean skill surface.
  // Permission.evaluate uses findLast, so LATER keys win: allow-all first, denies after.
  "permission": {
    "skill": {
      "*": "allow",
      "pcb-*": "deny",
      "schematic-*": "deny",
      "esp32-*": "deny",
      "stm32-*": "deny",
      "zephyr-*": "deny",
      "arduino-*": "deny",
      "*-iot": "deny",
      "mobile-developer": "deny",
      "flutter-expert": "deny"
    }
  }
}
