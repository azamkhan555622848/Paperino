{
  "$schema": "https://opencode.ai/config.json",
  // TEMPLATE — not loaded directly. packages/desktop/src/main/paperino/packaged.ts renders it
  // into {userData}/paperino-config/opencode.jsonc on every boot, resolving three tokens:
  // RESOURCES (<resourcesPath>/paperino), USERDATA (the app's userData dir) and ELECTRON (the
  // app's own executable, which behaves as node under ELECTRON_RUN_AS_NODE). Their braced
  // spellings are deliberately not written out here — the renderer would substitute them in
  // this very comment, and the generated file would then describe itself as a template.
  // The dev opencode.jsonc is never shipped: it is full of one machine's absolute paths.

  // The default model. Onboarding signs the user in to their ChatGPT subscription (openai
  // provider, codex OAuth plugin); Terra, Luna, Sol and gpt-5.3-codex then all appear in the
  // picker. They are deliberately NOT declared here: models.dev already carries them with their
  // real metadata, and a hand-written declaration can only invent facts — the one this replaced
  // claimed a 400k context for Terra, whose real window is 1.05M.
  "model": "openai/gpt-5.6-terra",

  "mcp": {
    // Figure Studio: a node-target bundle on the app's OWN runtime, so users need no bun
    // and no node. The render worker is a child process (Playwright hangs under bun), and
    // PAPERINO_FIGURES_NODE points it at the same executable.
    "figures": {
      "type": "local",
      "command": ["{{ELECTRON}}", "{{RESOURCES}}/figures-mcp/server.mjs"],
      "enabled": true,
      "environment": {
        "ELECTRON_RUN_AS_NODE": "1",
        "PAPERINO_FIGURES_NODE": "{{ELECTRON}}",
        "PAPERINO_JQ": "{{RESOURCES}}/bin/jq/jq.exe",
        "PLAYWRIGHT_BROWSERS_PATH": "{{USERDATA}}/browsers"
      }
    },
    // PaperBanana on the portable CPython that first-run setup installs. Generation takes
    // a minute or more, so the default MCP timeout is not enough.
    //
    // The models are NOT pinned here. Their id shape depends on which key the user connected —
    // OpenRouter namespaces them ("google/gemini-...") and Google's own API does not — so
    // server.py derives both from the resolved credential. Pinning the prefixed ids here would
    // hand a Google-key user an id their endpoint has never heard of.
    "paperbanana": {
      "type": "local",
      "command": ["{{USERDATA}}/python/python.exe", "{{RESOURCES}}/paperbanana/server.py"],
      "enabled": true,
      "timeout": 600000,
      "environment": {
        "PAPERBANANA_ROOT": "{{RESOURCES}}/paperbanana/PaperBanana-main"
      }
    }
  }

  // No InteJer disable-list here, unlike the dev config: the packaged sidecar runs with
  // its own XDG_CONFIG_HOME, so the machine-global ~/.config/opencode (InteJer's nine
  // hardware servers and its skills) is never merged in the first place.
}
