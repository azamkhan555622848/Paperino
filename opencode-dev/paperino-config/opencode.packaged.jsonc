{
  "$schema": "https://opencode.ai/config.json",
  // TEMPLATE — not loaded directly. packages/desktop/src/main/paperino/packaged.ts renders
  // this into {userData}/paperino-config/opencode.jsonc on every boot, substituting:
  //   {{RESOURCES}} -> <resourcesPath>/paperino   {{USERDATA}} -> the app's userData dir
  //   {{ELECTRON}}  -> the app's own executable (behaves as node via ELECTRON_RUN_AS_NODE)
  // The dev opencode.jsonc is never shipped: it is full of this machine's absolute paths.

  // GPT-5.6 Terra on the user's ChatGPT subscription, via opencode's built-in codex
  // OAuth plugin. Plan B adds luna/sol/codex and the onboarding wizard that signs in.
  "model": "openai/gpt-5.6-terra",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "id": "gpt-5.6-terra",
          "name": "GPT-5.6 Terra",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 400000, "input": 272000, "output": 128000 }
        }
      }
    }
  },

  "mcp": {
    // Figure Studio: a node-target bundle on the app's OWN runtime, so users need no bun
    // and no node. The render worker is a child process (Playwright hangs under bun), and
    // PAPERINO_FIGURES_NODE points it at the same executable.
    "figures": {
      "type": "local",
      "command": ["{{ELECTRON}}", "{{RESOURCES}}/figures-mcp/server.mjs"],
      "enabled": true,
      "environment": {
        "ELECTRON_RUN_AS_NODE": "1",
        "PAPERINO_FIGURES_NODE": "{{ELECTRON}}",
        "PAPERINO_JQ": "{{RESOURCES}}/bin/jq/jq.exe",
        "PLAYWRIGHT_BROWSERS_PATH": "{{USERDATA}}/browsers"
      }
    },
    // PaperBanana on the portable CPython that first-run setup installs. Generation takes
    // a minute or more, so the default MCP timeout is not enough.
    "paperbanana": {
      "type": "local",
      "command": ["{{USERDATA}}/python/python.exe", "{{RESOURCES}}/paperbanana/server.py"],
      "enabled": true,
      "timeout": 600000,
      "environment": {
        "PAPERBANANA_ROOT": "{{RESOURCES}}/paperbanana/PaperBanana-main",
        "MAIN_MODEL_NAME": "google/gemini-3.5-flash",
        "IMAGE_GEN_MODEL_NAME": "google/gemini-3.1-flash-image-preview"
      }
    }
  }

  // No InteJer disable-list here, unlike the dev config: the packaged sidecar runs with
  // its own XDG_CONFIG_HOME, so the machine-global ~/.config/opencode (InteJer's nine
  // hardware servers and its skills) is never merged in the first place.
}
